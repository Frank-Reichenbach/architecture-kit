#!/usr/bin/env node
// Launcher for architecture-kit. It runs in two places:
// - as the npm bin of the kit installed in a target repo's .architecture-kit/node_modules
// - from the Claude Code plugin's bin/ directory on PATH
// The kit installed in the workspace always wins, so the version a repository pins is the one that runs.
// Only `init` and `help` run from the plugin itself (they need no dependencies).

import { spawnSync } from 'node:child_process'
import { existsSync, realpathSync } from 'node:fs'
import { createRequire } from 'node:module'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { findWorkspace } from '../lib/workspace.mjs'

const argv = process.argv.slice(2)
const command = argv[0]
const self = realpathSync(fileURLToPath(import.meta.url))

const dirIndex = argv.indexOf('--dir')
const workspace = dirIndex >= 0 ? path.resolve(argv[dirIndex + 1]) : findWorkspace()
const installed = workspace && path.join(workspace, 'node_modules', 'architecture-kit', 'bin', 'architecture-kit')
const delegate = command !== 'init' && installed && existsSync(installed) && realpathSync(installed) !== self

const resolvable = (() => {
  try {
    createRequire(import.meta.url).resolve('likec4/package.json')
    return true
  } catch {
    return false
  }
})()

if (delegate) {
  const result = spawnSync(process.execPath, [installed, ...argv], { stdio: 'inherit' })
  process.exitCode = result.status ?? 1
} else if (resolvable) {
  const { main } = await import('../lib/cli.mjs')
  process.exitCode = await main(argv)
} else if (command === 'init') {
  const { init } = await import('../lib/init.mjs')
  const opt = name => (argv.includes(name) ? argv[argv.indexOf(name) + 1] : undefined)
  init(process.cwd(), { name: opt('--name'), title: opt('--title'), kitSource: opt('--kit'), install: !argv.includes('--no-install') })
} else if (command === undefined || ['help', '--help', '-h'].includes(command)) {
  console.log('architecture-kit: run `architecture-kit init` in a repository root, then `architecture-kit help` there.')
} else {
  console.error(workspace
    ? `architecture-kit is not installed in ${workspace}. Run: cd ${path.relative(process.cwd(), workspace) || '.'} && npm install`
    : 'No .architecture-kit/ workspace found. Run `architecture-kit init` in the repository root first.')
  process.exitCode = 1
}
