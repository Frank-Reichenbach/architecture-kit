views {

  deployment view sites {
    title 'Network — Sites and WAN'
    description 'Both sites, their internet uplinks and the site-to-site VPN.'
    include
      wan,
      wan.customers,
      prod.dc,
      prod.dc.edgeFw,
      office.hq,
      office.hq.officeFw
    // physical uplinks and tunnels only; logical traffic is in crossSiteTraffic
    exclude * -> * where kind is not netlink and kind is not vpn
    autoLayout LeftRight
  }

  deployment view prodNetwork {
    title 'Network — Production Data Centre'
    description 'VLANs, subnets and hosts in the data centre and how they are cabled. No software shown.'
    include
      prod.dc,
      prod.dc.*,
      prod.dc.dmz.*,
      prod.dc.apps.*,
      prod.dc.data.*,
      prod.dc.mgmt.*,
      wan
    // cabling only; traffic between software is in prodDeployment
    exclude * -> * where kind is not netlink
    autoLayout TopBottom
  }

  deployment view prodDeployment {
    title 'Deployment — Production'
    description 'Which software runs on which host in which VLAN, and the traffic between them.'
    include prod.**
    exclude * -[netlink]-> *
    exclude prod.dc.edgeFw, prod.dc.core
    autoLayout TopBottom
  }

  deployment view officeNetwork {
    title 'Network — Office & Warehouse'
    description 'Office VLANs, Wi-Fi, cabling and which software runs on-premises.'
    include
      office.**,
      wan
    // cabling only; software is shown inside its host, traffic is in crossSiteTraffic
    exclude * -> * where kind is not netlink
    autoLayout TopBottom
  }

  deployment view crossSiteTraffic {
    title 'Deployment — Traffic Between Sites'
    description 'Logical connections that leave a site: through the VPN or to the internet.'
    include
      office.hq.warehouseLan.wmsHost.wms,
      prod.dc.data.brokerVm.eventBus,
      prod.dc.mgmt.monVm.prometheus,
      prod.dc.apps.k8s.payments,
      prod.dc.apps.k8s.notifier,
      wan.saas.*
    autoLayout LeftRight
  }
}
