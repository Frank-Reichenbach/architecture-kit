// Production: a rented rack in a hosting data centre.
// Network zones are VLANs behind one firewall cluster that routes and filters between them.

deployment {

  environment prod 'Production' {
    description 'Everything the online shop needs to run, hosted in one data centre rack.'

    site dc 'Data Centre Frankfurt' {
      description 'Rented rack with two uplinks, colocated hardware.'

      edgeFw = firewall 'Edge Firewall' {
        #critical
        description 'Routes and filters between internet and all VLANs, terminates the site-to-site VPN. Default deny.'
        technology 'OPNsense, HA pair'
        metadata {
          wan_ip '203.0.113.10'
        }
      }

      core = switch 'Core Switch' {
        description 'Carries all VLANs as 802.1Q trunk between firewall and hosts.'
        technology '10 GbE managed L2'
      }

      dmz = network 'DMZ' {
        description 'Only zone reachable from the internet (ports 80/443).'
        metadata {
          vlan '10'
          cidr '10.10.10.0/24'
          gateway '10.10.10.1'
        }

        proxy = vm 'Reverse Proxy' {
          description 'TLS termination, routing to the cluster ingress, rate limiting.'
          technology 'HAProxy'
          metadata {
            ip '10.10.10.10'
          }
        }
      }

      apps = network 'App VLAN' {
        description 'Kubernetes nodes running all stateless shop services.'
        metadata {
          vlan '20'
          cidr '10.10.20.0/24'
          gateway '10.10.20.1'
        }

        k8s = cluster 'Kubernetes Cluster' {
          description '3 nodes; all shop services run as deployments with 2+ replicas.'
          technology 'k3s'
          metadata {
            ip '10.10.20.11-13'
          }

          instanceOf shop.storefront
          instanceOf shop.backoffice
          instanceOf shop.identity
          instanceOf shop.catalog
          instanceOf shop.orders
          instanceOf shop.payments
          instanceOf shop.notifier
        }
      }

      data = network 'Data VLAN' {
        #pii
        description 'Stateful services. Reachable only from the App VLAN and, for AMQPS, over the VPN.'
        metadata {
          vlan '30'
          cidr '10.10.30.0/24'
          gateway '10.10.30.1'
        }

        dbHost = server 'Database Server' {
          description 'PostgreSQL primary; streaming replica on a second server not shown.'
          technology 'Debian, PostgreSQL 17'
          metadata {
            ip '10.10.30.10'
          }

          instanceOf shop.catalogDb
          instanceOf shop.ordersDb
        }

        brokerVm = vm 'Broker VM' {
          technology 'RabbitMQ, 3-node cluster'
          description 'Message broker for shop and warehouse events.'
          metadata {
            ip '10.10.30.20'
          }

          instanceOf shop.eventBus
        }

        searchVm = vm 'Search VM' {
          technology 'OpenSearch'
          description 'Product search index (rebuildable from Catalog DB).'
          metadata {
            ip '10.10.30.30'
          }

          instanceOf shop.searchIndex
        }
      }

      mgmt = network 'Management VLAN' {
        description 'Monitoring, out-of-band management, admin access only via VPN.'
        metadata {
          vlan '99'
          cidr '10.10.99.0/24'
          gateway '10.10.99.1'
        }

        monVm = vm 'Monitoring VM' {
          technology 'Docker Compose'
          description 'Runs Prometheus, Alertmanager and Grafana.'
          metadata {
            ip '10.10.99.10'
          }

          instanceOf monitoring.prometheus
          instanceOf monitoring.grafana
        }
      }

      // ── Physical / L2 links ──
      edgeFw -[netlink]-> core '802.1Q trunk (VLAN 10, 20, 30, 99)'
      core -[netlink]-> proxy 'VLAN 10'
      core -[netlink]-> k8s 'VLAN 20'
      core -[netlink]-> dbHost 'VLAN 30'
      core -[netlink]-> brokerVm 'VLAN 30'
      core -[netlink]-> searchVm 'VLAN 30'
      core -[netlink]-> monVm 'VLAN 99'

      // ── Traffic that is not a logical relationship ──
      proxy -> k8s 'forwards HTTPS to ingress' {
        technology 'HTTPS 443'
      }
    }
  }
}
