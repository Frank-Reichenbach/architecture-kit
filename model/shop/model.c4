// Inside the Online Shop: containers and their relationships.

model {

  extend shop {

    storefront = webapp 'Storefront' {
      description 'Server-rendered web shop: browse catalog, search, cart and checkout.'
      technology 'Next.js'
      icon tech:nextjs
    }

    backoffice = webapp 'Backoffice' {
      description 'Internal UI for customer service: find orders, cancel, refund, register returns.'
      technology 'React SPA'
      icon tech:react
    }

    identity = service 'Identity Provider' {
      #pii
      description 'Login and accounts for customers and staff, single sign-on via OpenID Connect.'
      technology 'Keycloak'
    }

    catalog = service 'Catalog Service' {
      description 'Products, prices and stock availability; product search.'
      technology 'Spring Boot'
      icon tech:spring
    }

    catalogDb = database 'Catalog DB' {
      description 'Products, categories, prices, stock levels.'
      technology 'PostgreSQL'
      icon tech:postgresql
    }

    searchIndex = database 'Search Index' {
      description 'Full-text and faceted product search.'
      technology 'OpenSearch'
      icon tech:opensearch
    }

    orders = service 'Order Service' {
      #critical #pii
      description 'Cart, checkout and order lifecycle (placed → paid → shipped → delivered / returned).'
      technology 'Spring Boot'
      icon tech:spring
    }

    ordersDb = database 'Orders DB' {
      #pii
      description 'Carts, orders, order lines, shipping addresses.'
      technology 'PostgreSQL'
      icon tech:postgresql
    }

    payments = service 'Payment Service' {
      #critical
      description 'Wraps the payment provider: creates payments, receives webhooks, issues refunds. Stores no card data.'
      technology 'Go'
      icon tech:go
    }

    eventBus = queue 'Event Bus' {
      description 'Domain events between shop and warehouse: OrderPlaced, OrderPaid, OrderShipped, StockChanged.'
      technology 'RabbitMQ'
      icon tech:rabbitmq
    }

    notifier = service 'Notification Worker' {
      description 'Turns order events into customer e-mails.'
      technology 'Node.js'
      icon tech:nodejs
    }
  }

  // ───────────── People → shop ─────────────

  customer -> storefront 'browses, orders, tracks orders' {
    technology 'HTTPS'
  }
  customer -> paymentProvider 'pays on hosted payment page' {
    technology 'HTTPS, 3-D Secure'
  }
  support -> backoffice 'manages orders and refunds' {
    technology 'HTTPS'
  }

  // ───────────── Inside the shop ─────────────

  storefront -> catalog 'reads products, prices, search' {
    technology 'REST/JSON'
  }
  storefront -> orders 'manages cart, places orders' {
    technology 'REST/JSON'
  }
  storefront -> identity 'customer login, session check' {
    technology 'OIDC'
  }
  backoffice -> orders 'searches, cancels, refunds orders' {
    technology 'REST/JSON'
  }
  backoffice -> identity 'staff single sign-on' {
    technology 'OIDC'
  }

  catalog -> catalogDb 'reads and writes' {
    technology 'SQL'
  }
  catalog -> searchIndex 'indexes and queries products' {
    technology 'REST'
  }

  orders -> ordersDb 'reads and writes' {
    technology 'SQL'
  }
  orders -> catalog 'reserves stock' {
    technology 'REST/JSON'
  }
  orders -> payments 'requests payment / refund' {
    technology 'gRPC'
  }
  payments -> orders 'confirms payment status' {
    technology 'gRPC'
  }

  orders -[async]-> eventBus 'publishes OrderPlaced, OrderPaid' {
    technology 'AMQP'
  }
  eventBus -[async]-> orders 'delivers OrderShipped' {
    technology 'AMQP'
  }
  eventBus -[async]-> notifier 'delivers order events' {
    technology 'AMQP'
  }
  eventBus -[async]-> catalog 'delivers StockChanged' {
    technology 'AMQP'
  }

  // ───────────── Shop → external systems ─────────────

  payments -> paymentProvider 'creates payments, refunds' {
    technology 'HTTPS'
  }
  paymentProvider -> payments 'payment status webhooks' {
    technology 'HTTPS'
  }
  notifier -> emailService 'sends order e-mails' {
    technology 'SMTP/TLS'
  }
}
