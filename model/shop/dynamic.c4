// Scenarios: step-by-step flows through the shop. Steps must match relationships in the model.

views {

  dynamic view checkout {
    title 'Scenario — Checkout and Payment'
    description 'From "Buy now" to the confirmation e-mail and the paid order arriving in the warehouse.'
    variant sequence

    customer -> shop.storefront 'clicks "Buy now"'
    shop.storefront -> shop.orders 'POST /orders'
    shop.orders -> shop.catalog 'reserve stock'
    shop.orders -> shop.payments 'create payment'
    shop.payments -> paymentProvider 'create payment intent'
    shop.storefront <- shop.orders 'redirect URL to payment page'
    customer -> paymentProvider 'pays (3-D Secure)' {
      notes 'The card data never touches our systems.'
    }
    paymentProvider -> shop.payments 'webhook: payment succeeded'
    shop.payments -> shop.orders 'mark order paid'
    shop.orders -> shop.eventBus 'OrderPaid'
    parallel {
      shop.eventBus -> shop.notifier 'OrderPaid'
      shop.eventBus -> warehouse.wms 'OrderPaid'
    }
    shop.notifier -> emailService 'order confirmation'
  }

  dynamic view fulfilment {
    title 'Scenario — Picking and Shipping'
    description 'From a paid order to the customer receiving the shipping notice.'
    variant sequence

    shop.eventBus -> warehouse.wms 'OrderPaid'
    warehouse.wms -> warehouse.wmsDb 'create pick list'
    picker -> warehouse.scannerApp 'scans items'
    warehouse.scannerApp -> warehouse.wms 'confirm pick and pack'
    warehouse.wms -> carrier 'book shipment, get label'
    warehouse.wms -> shop.eventBus 'OrderShipped + StockChanged'
    parallel {
      shop.eventBus -> shop.orders 'OrderShipped'
      shop.eventBus -> shop.notifier 'OrderShipped'
      shop.eventBus -> shop.catalog 'StockChanged'
    }
    shop.notifier -> emailService 'shipping notice with tracking link'
  }
}
